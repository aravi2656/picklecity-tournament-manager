rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin records must be provisioned by a trusted project owner.
    // Clients cannot grant themselves admin access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public tournament pages may read tournament display data.
    // Only active admins may create or modify tournaments.
    match /tournaments/{tournamentId} {
      allow read: if resource.data.visibility == 'public' || isAdmin();
      allow create, update, delete: if isAdmin();

      match /{document=**} {
        allow read: if get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.visibility == 'public' || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Shared player directory is private by default.
    match /players/{playerId} {
      allow read, write: if isAdmin();
    }
  }
}